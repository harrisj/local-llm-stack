{
  "defaultModel": "granite",
  "defaultProvider": "router",
  "thinking_effort": "low",
  "lastChangelogVersion": "1.4.0",
  "httpIdleTimeoutMs": 0,
  "packages": [
    "npm:pi-plan",
    "npm:pi-show",
    "npm:pi-context-view",
    "npm:pi-tool-missing-guard",
    "npm:@sting8k/pi-utils",
    "npm:@nicknisi/pi-ast-grep",
    "npm:@henryqw/pi-ask-question",
    "npm:pi-ponytail",
    "npm:@jamesjfoong/pi-ollama",
    "git:github.com/code-yeongyu/pi-nested-agents-md",
    "npm:pi-blackhole",
    "npm:pi-mcp-adapter",
    "npm:model-debugger",
    "npm:@yeliu84/pi-model-router",
    "npm:pi-thinking-steps",
    "npm:pi-loop-police",
    "npm:pi-python",
    "npm:pi-tool-repair",
    "npm:pi-goal-x"
  ],
  "theme": "dark",
  "compaction": {
    "enabled": true
  },
  "defaultTools": [
    "+codemode",
    "+find",
    "+grep",
    "+ls",
    "+tool_search",
    "+ast_rewrite",
    "+ast_search"
  ],
  "retry.provider.timeoutMs": 300000,
  "hideThinkingBlock": false,
  "router.timeoutMs": 300000,
  "router.retry.maxRetries": 5,
  "router.retry.delayMs": 5000,
  "powerline": "default",
  "extensions": [
    "-builtin:mcp"
  ]
}