{
  "defaultModel": "auto",
  "defaultProvider": "router",
  "thinking_effort": "low",
  "lastChangelogVersion": "1.3.0",
  "httpIdleTimeoutMs": 0,
  "packages": [
    "npm:pi-plan",
    "npm:pi-show",
    "npm:pi-context-view",
    "npm:pi-tool-missing-guard",
    "npm:@sting8k/pi-utils",
    "npm:@nicknisi/pi-ast-grep",
    "npm:@henryqw/pi-ask-question",
    "npm:pi-ponytail",
    "npm:@jamesjfoong/pi-ollama",
    "git:github.com/code-yeongyu/pi-nested-agents-md",
    "npm:pi-blackhole",
    "npm:pi-mcp-adapter",
    "npm:model-debugger",
    "npm:@yeliu84/pi-model-router",
    "npm:billion-context",
    "npm:pi-thinking-steps",
    "npm:@capyup/pi-goal",
    "npm:pi-loop-police",
    "npm:pi-python"
