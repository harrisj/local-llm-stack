    "ollama/devstral-pi:latest",
    "router/auto",
    "ollama/granite-8b-pi:latest",
    "ollama/granite-30b-pi:latest",
    "ollama/lfm-pi:latest",
    "ollama/mistral-pi:latest",
    "ollama/pi-classifier:latest"
  ],
  "powerline": "default",
  "extensions": [
    "-builtin:mcp"
  ]
}