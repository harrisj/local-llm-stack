{
  "debug": false,
  "defaultProfile": "local",
  "modes": {
    "cost": { "policy": { "costSensitivity": 0.8, "escalationHoldTurns": 1 } },
    "quality": {
      "policy": { "costSensitivity": 0.2, "escalationHoldTurns": 4 }
    }
  },
  "advisor": {
    "enabled": true,
    "model": "inference/metis",
    "timeoutMs": 10000,
    "reviewEveryRequests": 4,
    "confidenceThreshold": 0.65,
    "probabilityThreshold": 0.8,
    "maxStateTokens": 3000,
    "context": {
      "currentLoopMessages": 8,
      "previousTurns": 2,
      "maxHistoryTokens": 500,
      "toolResults": "last-error",
      "maxToolTokens": 250
    },
    "maxRetries": 1
  },
  "profiles": {
    "fast-code": {
      "advisor": { "models": ["inference/metis"] },
      "activityPreset": "auto",
      "activityRouting": {
        "code": "low",
        "debug": "medium",
        "explore": "low",
        "plan": "high",
        "review": "medium",
        "ops": "low",
        "docs": "micro"
      },
      "micro": {
        "model": "ollama/flint:latest",
        "thinking": "off",
        "options": { "num_thread": 8, "keep_alive": "-1" }
      },
      "low": {
        "model": "ollama/flint:latest",
        "thinking": "low",
        "options": { "num_thread": 8, "keep_alive": "-1" }
      },
      "medium": {
        "model": "ollama/north-mini-pi:latest",
        "thinking": "medium",
        "options": {
          "num_thread": 8,
          "keep_alive": "-1",
          "num_ctx": 65536
        }
      },
      "high": {
        "model": "inference_coop/regolo/apertus-70b",
        "contextWindow": 262288,
        "thinking": "high",
        "options": { "think": true, "num_ctx": 262288 }
      }
    },
    "debug-agent": {
      "advisor": { "models": ["inference/metis"] },
      "activityPreset": "auto",
      "activityRouting": {
        "code": "medium",
        "debug": "high",
        "explore": "low",
        "plan": "high",
        "review": "high",
        "ops": "medium",
        "docs": "micro"
      },
      "micro": {
        "model": "ollama/north-mini-pi:latest",
        "thinking": "off",
        "options": { "num_thread": 8, "keep_alive": "-1" }
      },
      "low": {
        "model": "ollama/north-mini-pi:latest",
        "thinking": "low",
        "options": {
          "num_thread": 8,
          "keep_alive": "-1"
        }
      },
      "medium": {
        "model": "ollama/ornith-pi:latest",
        "thinking": "medium",
        "options": {
          "num_thread": 8,
          "keep_alive": "-1"
        }
      },
      "high": {
        "model": "ollama/ornith-pi:latest",
        "thinking": "high",
        "options": { "num_thread": 8, "keep_alive": "-1" }
      }
    },
    "heavy-context": {
      "advisor": { "models": ["inference/metis"] },
      "activityPreset": "auto",
      "activityRouting": {
        "code": "medium",
        "debug": "medium",
        "explore": "low",
        "plan": "high",
        "review": "medium",
        "ops": "low",
        "docs": "micro"
      },
      "micro": {
        "model": "ollama/granite-8b:latest",
        "thinking": "low",
        "options": { "num_thread": 8, "keep_alive": "-1" }
      },
      "low": {
        "model": "ollama/north-mini-pi:latest",
        "thinking": "low",
