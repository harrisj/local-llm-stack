{
  "debug": true,
  "defaultContextThresholdPercent": 85,
  "stickyTierDurationTurns": 2,
  "stickyTierCooldownTurns": 2,
  "classifierModel": "ollama/pi-classifier:latest",
  "classifierModels": ["ollama/pi-classifier:latest"],
  "classifier": {
    "enabled": true,
    "models": ["ollama/pi-classifier:latest"]
  },
  "profiles": {
    "auto": {
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "temperature": 0.0,
          "num_ctx": 65536,
          "num_predict": 4096,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": -1
        }
      },
      "medium": {
        "model": "ollama/lfm-pi:latest",
        "contextWindow": 131072,
        "thinking": "off",
        "options": {
          "temperature": 0.1,
          "num_ctx": 131072,
          "num_predict": 8192,
          "num_thread": 8,
          "keep_alive": -1
        }
      },
      "high": {
        "model": "ollama/granite-30b-pi:latest",
        "contextWindow": 131072,
        "thinking": "high",
        "options": {
          "temperature": 0.1,
          "num_ctx": 131072,
          "num_predict": 8192,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": 0,
          "system": "You are executing an autonomous goal loop. Use your deep internal reasoning to orchestrate complex architectural strategies."
        }
      }
    }
  },
  "rules": [
    {
      "matches": ["create_goal", "get_goal", "update_goal", "[goal]", "/goal"],
      "tier": "medium",
      "reason": "Goal workflow indicators forced straight to medium tier"
    },
    {
      "matches": [
        "write",
        "implement",
        "create",
        "generate",
        "patch",
        "refactor",
        "migrate",
        "serializer",
        "pydantic",
        "django"
      ],
      "tier": "medium",
      "reason": "Activity-based programming verbs forced to medium tier"
    },
    {
      "matches": ["hello", "hi", "hey", "echo", "say hello", "greetings"],
      "tier": "low",
      "reason": "Trivial interactions filtered to low tier"
    }
  ],
  "fallbacks": {
    "ollama/granite-30b-pi:latest": ["ollama/lfm-pi:latest"],
    "ollama/lfm-pi:latest": ["ollama/granite-8b-pi:latest"]
  }
}
