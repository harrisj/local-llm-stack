  },
  "heuristics": [
    {
      "matches": [
        "(!high|/high|--high|force-high|force-critical)",
        "architecture-plan"
      ],
      "tier": "high",
      "reason": "Explicit manual overrides to force heavy reasoning tier."
    },
    {
      "matches": ["(!medium|/medium|--medium|force-medium)", "architect"],
      "tier": "medium",
      "reason": "Explicit manual overrides for mid-tier reasoning workflows."
    },
    {
      "matches": ["(!low|/low|--low|force-low)"],
      "tier": "low",
      "reason": "Manual override flag forcing standard implementation tier."
    },
    {
      "matches": ["(!micro|/micro|--micro|force-micro)"],
      "tier": "micro",
      "reason": "Manual override flag forcing lightweight environment tier."
    },
    {
      "matches": [
        "race condition",
        "deadlock",
        "memory leak",
        "mutex",
        "semaphore",
        "transaction",
        "crash dump",
        "propose_goal_draft",
        "update_goal",
        "apply_goal_tweak",
        "audit_goal",
        "goal_audit",
        "goal auditing",
        "audit goal",
        "rearchitect",
        "refactor",
        "completely revise"
      ],
      "tier": "high",
      "reason": "High-priority catastrophic runtime bugs evaluated BEFORE simple verbs."
    },
    {
      "matches": [
        "profile",
        "benchmark",
        "slowdown",
        "stuck",
        "hang",
        "freeze",
        "optimize",
        "performance",
        "get_goal",
        "pause_goal",
        "abort_goal"
      ],
      "tier": "low",
      "reason": "Standard performance profiling metrics."
    }
  ],
  "fallbacks": {
    "inference_coop/regolo/apertus-70b": [
      "ollama/ornith-pi:latest",
      "ollama/granite-30b-pi:latest",
      "ollama/north-mini-pi:latest"
    ],
    "ollama/ornith-pi:latest": [
      "ollama/granite-30b-pi:latest",
      "ollama/north-mini-pi:latest"
    ],
    "ollama/granite-30b-pi:latest": ["ollama/north-mini-pi:latest"],
    "ollama/north-mini-pi:latest": [
      "ollama/granite-8b:latest",
      "ollama/flint:latest"
    ],
    "ollama/granite-8b:latest": ["ollama/flint:latest"],
    "ollama/flint:latest": []
  }
}
