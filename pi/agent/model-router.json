{
  "debug": true,
  "defaultContextThresholdPercent": 85,
  "stickyTierDurationTurns": 2,
  "stickyTierCooldownTurns": 2,
  "classifierModel": "ollama/pi-classifier:latest",
  "classifierModels": ["ollama/pi-classifier:latest"],
  "classifier": {
    "enabled": true,
    "models": ["ollama/pi-classifier:latest"]
  },
  "profiles": {
    "auto": {
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "temperature": 0.0,
          "num_ctx": 65536,
          "num_predict": 4096,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": -1
        }
      },
      "medium": {
        "model": "ollama/lfm-pi:latest",
        "contextWindow": 131072,
        "thinking": "off",
        "options": {
          "temperature": 0.1,
          "num_ctx": 131072,
          "num_predict": 8192,
          "num_thread": 8,
          "keep_alive": -1
        }
      },
      "high": {
        "model": "ollama/granite-30b-pi:latest",
        "contextWindow": 131072,
        "thinking": "high",
        "options": {
          "temperature": 0.1,
          "num_ctx": 131072,
          "num_predict": 8192,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": 0,
          "system": "You are executing an autonomous goal loop. Use your deep internal reasoning to orchestrate complex architectural strategies."
        }
      }
    }
  },
  "rules": [
    {
      "matches": "(?i)(!high|\\/high|--high|architect|force-high)",
      "tier": "high",
      "reason": "Manual override flag to force the high reasoning tier immediately"
    },
    {
      "matches": "(?i)(!medium|\\/medium|--medium|force-medium)",
      "tier": "medium",
      "reason": "Manual override flag to force the medium coding tier immediately"
    },
    {
      "matches": "(?i)(!low|\\/low|--low|force-low)",
      "tier": "low",
      "reason": "Manual override flag to force the low tier immediately"
    },
    {
      "matches": "(?i)(create_goal|get_goal|update_goal|propose_goal_draft|set_goal_tasks|goal_questionnaire|goal_confirmation|goal_topic|\\[GOAL\\]|__goal__|<goal_topic>|\\/goal)",
      "tier": "high",
      "reason": "Pi-Goal orchestrator strings lock into high reasoning mode"
    },
    {
      "matches": "(?i)(refactor project|restructure repo|system design|metaprogramming|race condition|deadlock|memory leak|deep dive|benchmark|profile|gil|concurrency|thread pool|active record|sqlalchemy|freeze|hang|stuck|slowdown|optimize|scale|async|await|parallel|lock|mutex|semaphore|architecture|design|database|schema|security)",
      "tier": "high",
      "reason": "Heavy architectural reasoning, structural refactoring, and concurrency patterns"
    },
    {
      "matches": "(?i)\\b\\w+\\.(js|ts|go|cpp|rs|java|py|rb|sql)\\b",
      "tier": "medium",
      "reason": "Standard programming and query language script interaction shortcut"
    },
    {
      "matches": "(?i)\\b\\w+\\.(txt|ini|cfg|conf|toml|json|yaml|md)\\b",
      "tier": "low",
      "reason": "Config and documentation file extensions filtered to low tier"
    }
  ],
  "fallbacks": {
    "ollama/granite-30b-pi:latest": ["ollama/lfm-pi:latest"],
    "ollama/lfm-pi:latest": ["ollama/granite-8b-pi:latest"]
  },
  "phaseMemory": true,
  "minTurnsPerTier": 2,
  "phaseMemoryConfig": {
    "decayRate": 0.5,
    "boostRulesTier": true
  }
}
