{
  "$schema": "https://githubusercontent.com",
  "debug": false,
  "defaultProfile": "auto",
  "maxContextTokens": 131072,
  "modes": {
    "cost": {
      "policy": {
        "costSensitivity": 0.8,
        "escalationHoldTurns": 1
      }
    },
    "quality": {
      "policy": {
        "costSensitivity": 0.2,
        "escalationHoldTurns": 4
      }
    }
  },

  "advisor": {
    "enabled": true,
    "model": "inference/metis",
    "timeoutMs": 10000,
    "reviewEveryRequests": 4,
    "confidenceThreshold": 0.65,
    "probabilityThreshold": 0.8,
    "maxStateTokens": 3000,
    "context": {
      "currentLoopMessages": 8,
      "previousTurns": 2,
      "maxHistoryTokens": 500,
      "toolResults": "last-error",
      "maxToolTokens": 250
    },
    "maxRetries": 1
  },

  "profiles": {
    "auto": {
      "advisor": {
        "models": ["inference/metis"]
      },
      "activityPreset": "auto",
      "activityRouting": {
        "code": "low",
        "debug": "medium",
        "explore": "low",
        "plan": "high",
        "review": "medium",
        "ops": "low",
        "docs": "micro"
      },
      "micro": {
        "model": "ollama/flint:latest",
        "thinking": "low",
        "options": { "num_thread": 8, "keep_alive": "-1", "num_predict": 256 }
      },
      "low": {
        "model": "ollama/flint:latest",
        "thinking": "low",
        "options": { "num_thread": 8, "keep_alive": "-1", "num_predict": 4096 }
      },
      "medium": {
        "model": "ollama/flint:latest",
        "thinking": "medium",
        "options": { "num_thread": 8, "keep_alive": "-1", "num_predict": 4096 }
      },
      "high": {
        "model": "inference_coop/regolo/apertus-70b",
        "contextWindow": 262288,
        "thinking": "high",
        "options": { "think": true, "num_ctx": 262288 }
      }
    },
    "local": {
      "activityPreset": "auto",
      "activityRouting": {
        "code": "low",
        "debug": "medium",
        "explore": "low",
        "plan": "high",
        "review": "medium",
        "ops": "low",
        "docs": "micro"
      },
      "advisor": {
        "models": ["inference-coop/metis"]
      },
      "micro": {
        "model": "ollama/flint:latest",
        "thinking": "low",
        "options": { "num_thread": 8, "keep_alive": "-1", "num_predict": 256 }
      },
      "low": {
        "model": "ollama/flint:latest",
        "thinking": "low",
        "options": { "num_thread": 8, "keep_alive": "-1", "num_predict": 4096 }
      },
      "medium": {
        "model": "ollama/flint:latest",
        "thinking": "medium",
        "options": { "num_thread": 8, "keep_alive": "-1", "num_predict": 4096 }
      },
      "high": {
        "model": "ollama/granite-30b-pi:latest",
        "contextWindow": 131072,
        "thinking": "high",
        "options": { "num_ctx": 131072, "num_thread": 8, "keep_alive": "-1" }
      }
    }
  },

  "heuristics": [
    {
      "matches": [
        "^(!high|/high|--high|force-high|force-critical)$",
        "architecture-plan"
      ],
      "tier": "high",
      "reason": "Explicit manual overrides to force heavy reasoning tier."
    },
    {
      "matches": ["^(!medium|/medium|--medium|force-medium)$", "architect"],
      "tier": "medium",
      "reason": "Explicit manual overrides for mid-tier reasoning workflows."
    },
    {
      "matches": ["^(!low|/low|--low|force-low)$"],
      "tier": "low",
      "reason": "Manual override flag forcing standard implementation tier."
    },
    {
      "matches": ["^(!micro|/micro|--micro|force-micro)$"],
      "tier": "micro",
      "reason": "Manual override flag forcing lightweight environment tier."
    },
    {
      "matches": [
        "race condition",
        "deadlock",
        "memory leak",
        "mutex",
        "semaphore",
        "transaction",
        "crash dump",
        "propose_goal_draft",
        "update_goal",
        "apply_goal_tweak",
        "audit_goal",
        "goal_audit",
        "goal auditing",
        "audit goal"
      ],
      "tier": "high",
      "reason": "High-priority catastrophic runtime bugs and planning metrics evaluated BEFORE simple verbs."
    },
    {
      "matches": [
        "print",
        "echo",
        "format",
        "lint",
        "prettier",
        "eslint",
        "ruff",
        "black",
        "pip",
        "npm",
        "install",
        "bump",
        "version",
        "typo",
        "fix typo",
        "comment",
        "comments",
        "docs",
        "docstring",
        "rubocop",
        "flake8",
        "autopep8",
        "run tests",
        "pytest",
        "unittest",
        "readme",
        "changelog",
        "yaml",
        "toml",
        "json",
        "ini",
        "cfg",
        "conf",
        "setup.cfg",
        "manage.py",
        "run make",
        "rake",
        "test",
        "ping",
        "clear session",
        "reset context"
      ],
      "tier": "micro",
      "reason": "Environment hygiene and syntax checks evaluated before broader action verbs."
    },
    {
      "matches": [
        "profile",
        "benchmark",
        "slowdown",
        "stuck",
        "hang",
        "freeze",
        "optimize",
        "performance",
        "get_goal",
        "pause_goal",
        "abort_goal"
      ],
      "tier": "low",
      "reason": "Standard performance profiling metrics."
    }
  ],

  "fallbacks": {
    "inference_coop/regolo/apertus-70b": [
      "ollama/granite-30b-pi:latest",
      "ollama/flint:latest"
    ],
    "ollama/granite-30b-pi:latest": ["ollama/flint:latest"],
    "ollama/flint:latest": []
  }
}
