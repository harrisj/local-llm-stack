{
  "debug": false,
  "defaultContextThresholdPercent": 80,
  "contextThresholdPercentOverrides": {
    "ollama/granite-8b-pi:latest": 75,
    "ollama/mistral-pi:latest": 90,
    "ollama/granite-30b-pi:latest": 80
  },
  "maxContextTokens": 65536,
  "onContextOverflow": "truncate",
  "classifierModel": "ollama/pi-classifier:latest",
  "classifierModels": ["ollama/pi-classifier:latest"],
  "classifier": {
    "enabled": true,
    "models": ["ollama/pi-classifier:latest"],
    "options": {
      "temperature": 0.0,
      "num_ctx": 4096,
      "num_predict": 64,
      "keep_alive": -1
    },
    "systemPrompt": "You are a highly efficient, deterministic model router classifier. Your sole job is to categorize the user's latest workspace request into one of three structural tiers: 'high', 'medium', or 'low'.\n\nTIER CRITERIA:\n- high: Deep architectural planning, complex concurrency analysis, multi-module dependency refactoring, or critical diagnostic tracing.\n- medium: Focused feature implementations, multi-file code modifications, standard performance optimization profiling, or unit test generation.\n- low: Environment hygiene, code linting, syntax formatting adjustments, typo fixes, or lightweight read-only configuration lookups.\n\nOUTPUT FORMAT:\nReturn your decision in exactly two lines with no extra text or markdown formatting:\nTier: [high|medium|low]\nReasoning: [One short sentence detailing the key technical vector mapping the request to this tier]",
    "promptTemplate": "Context State Summary:\n{phase_summary}\n\nRecent Turn History:\n{history}\n\nLatest Workspace Command/Message:\n{prompt}\n\nCompute optimal execution layer classification immediately according to system constraints."
  },
  "stickyTierDurationTurns": 2,
  "minTurnsPerTier": 1,
  "phaseBias": 0.85,
  "compactionEngine": "blackhole",
  "defaultProfile": "auto",
  "profiles": {
    "auto": {
      "low": {
        "model": "ollama/flint:latest",
        "thinking": "off",
        "keep_alive": "-1",
        "options": {
          "num_thread": 8,
          "keep_alive": "-1"
        }
      },
      "medium": {
        "model": "ollama/flint:latest",
        "thinking": "medium",
        "options": {
          "num_thread": 8,
          "keep_alive": "-1"
        }
      },
      "high": {
        "model": "ollama/granite-30b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "think": true,
          "num_ctx": 65536,
          "num_thread": 8,
          "keep_alive": "-1",
          "timeout": "300s"
        }
      }
    },
    "granite": {
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "think": false,
          "num_ctx": 65536,
          "num_predict": 2048,
          "num_thread": 8,
          "keep_alive": -1,
          "timeout": "45s"
        }
      },
      "medium": {
        "model": "ollama/granite-8b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "think": true,
          "num_ctx": 65536,
          "num_predict": 8192,
          "num_thread": 8,
          "keep_alive": -1,
          "timeout": "120s"
        }
      },
      "high": {
        "model": "ollama/granite-30b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "think": true,
          "num_ctx": 65536,
          "num_thread": 8,
          "keep_alive": -1,
          "timeout": "300s"
        }
      }
    }
  },
  "rules": [
    {
      "matches": ["!high", "/high", "--high", "architect", "force-high"],
      "tier": "high",
      "reason": "Explicit manual overrides to force the heavy reasoning model"
    },
    {
      "matches": ["!medium", "/medium", "--medium", "force-medium"],
      "tier": "medium",
      "reason": "Manual override flag forcing standard implementation tier"
    },
    {
      "matches": ["!low", "/low", "--low", "force-low"],
      "tier": "low",
      "reason": "Manual override flag forcing lightweight low tier"
    },
    {
      "matches": [
        "race condition",
        "deadlock",
        "memory leak",
        "mutex",
        "semaphore",
        "transaction",
        "crash dump"
      ],
      "tier": "high",
      "reason": "Strict runtime concurrency bugs and engine-level diagnostics that warrant single-turn 30B analysis"
    },
    {
      "matches": [
        "propose_goal_draft",
        "goal_question",
        "goal_questionnaire",
        "update_goal",
        "get_goal",
        "apply_goal_tweak",
        "abort_goal",
        "pause_goal"
      ],
      "tier": "high",
      "reason": "Intercepts native goal tool calls and routes to a reasoning tier"
    },
    {
      "matches": [
        "write",
        "implement",
        "create",
        "generate",
        "patch",
        "refactor",
        "modify",
        "update",
        "migrate",
        "port",
        "translate",
        "integrate",
        "endpoint",
        "route",
        "fix"
      ],
      "tier": "medium",
      "reason": "Pure implementation, feature writing, and codebase modification verbs intercepted by the medium tier"
    },
    {
      "matches": [
        "profile",
        "benchmark",
        "slowdown",
        "stuck",
        "hang",
        "freeze",
        "optimize",
        "performance"
      ],
      "tier": "medium",
      "reason": "Standard performance profiling, code optimization, and loop diagnostics handled in the medium tier"
    },
    {
      "matches": [
        "print",
        "echo",
        "format",
        "lint",
        "prettier",
        "eslint",
        "ruff",
        "black",
        "pip",
        "npm",
        "install",
        "bump",
        "version",
        "typo",
        "fix typo",
        "comment",
        "comments",
        "docs",
        "docstring",
        "rubocop",
        "flake8",
        "autopep8",
        "run tests",
        "pytest",
        "unittest",
        "readme",
        "changelog",
        "yaml",
        "toml",
        "json",
        "ini",
        "cfg",
        "conf",
        "count",
        "setup.cfg",
        "manage.py",
        "run make",
        "rake"
      ],
      "tier": "low",
      "reason": "Environment hygiene, lint runs, syntax formatting, and lightweight configurations safely handled by Granite-8B tools"
    },
    {
      "matches": ["test", "ping", "clear session", "reset context"],
      "tier": "low",
      "reason": "Deterministic system check patterns and workflow diagnostics"
    }
  ],
  "fallbacks": {
    "ollama/granite-30b-pi:latest": ["ollama/granite-8b-pi:latest"],
    "ollama/granite-8b-pi:latest": []
  }
}
