{
  "debug": false,
  "defaultProfile": "local",
  "modes": {
    "cost": { "policy": { "costSensitivity": 0.8, "escalationHoldTurns": 1 } },
    "quality": {
      "policy": { "costSensitivity": 0.2, "escalationHoldTurns": 2 }
    }
  },
  "advisor": {
    "enabled": true,
    "model": "inference/metis",
    "timeoutMs": 10000,
    "reviewEveryRequests": 4,
    "confidenceThreshold": 0.65,
    "probabilityThreshold": 0.8,
    "maxStateTokens": 3000,
    "context": {
      "currentLoopMessages": 8,
      "previousTurns": 2,
      "maxHistoryTokens": 500,
      "toolResults": "last-error",
      "maxToolTokens": 250
    },
    "maxRetries": 1
  },
  "profiles": {
    "local": {
      "advisor": { "models": ["inference/metis"] },
      "activityPreset": "auto",
      "activityRouting": {
        "code": "medium",
        "debug": "medium",
        "explore": "low",
        "plan": "high",
        "review": "medium",
        "ops": "low",
        "docs": "micro"
      },
      "micro": {
        "model": "ollama/granite-8b-pi:latest",
        "thinking": "off"
      },
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "thinking": "low"
      },
      "medium": {
        "model": "ollama/ornith-pi:latest",
        "thinking": "medium"
      },
      "high": {
        "model": "ollama/ornith-pi:latest",
        "thinking": "high"
      }
    },
    "inkling": {
      "advisor": { "models": ["inference/metis"] },
      "activityPreset": "auto",
      "activityRouting": {
        "code": "medium",
        "debug": "high",
        "explore": "low",
        "plan": "high",
        "review": "high",
        "ops": "low",
        "docs": "micro"
      },
      "micro": {
        "model": "ollama/granite-8b-pi:latest",
        "thinking": "off"
      },
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "thinking": "low"
      },
      "medium": {
        "model": "ollama/inkling-pi:latest",
        "thinking": "medium"
      },
      "high": {
        "model": "ollama/inkling-pi:latest",
        "thinking": "high"
      }
    },
    "heavy-context": {
      "advisor": { "models": ["inference/metis"] },
      "activityPreset": "auto",
      "activityRouting": {
        "code": "medium",
        "debug": "medium",
        "explore": "low",
        "plan": "high",
        "review": "high",
        "ops": "low",
        "docs": "micro"
      },
      "micro": {
        "model": "ollama/granite-8b-pi:latest",
        "thinking": "off"
      },
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "thinking": "medium"
      },
      "medium": {
        "model": "ollama/ornith-pi:latest",
        "thinking": "medium"
      },
      "high": {
        "model": "inference_coop/regolo/apertus-70b",
        "contextWindow": 262288,
        "thinking": "high",
        "options": { "think": true }
      }
    }
  },
  "heuristics": [
    {
      "matches": [
        "(?:^|\\s)(!high|/high|--high|force-high|force-critical)(?=\\s|$)",
        "\\barchitecture-plan\\b"
      ],
      "tier": "high",
      "reason": "Explicit manual overrides to force heavy reasoning tier."
    },
    {
      "matches": ["(?:^|\\s)(!medium|/medium|--medium|force-medium)(?=\\s|$)"],
      "tier": "medium",
      "reason": "Manual override flag forcing mid-tier reasoning."
    },
    {
      "matches": ["(?:^|\\s)(!low|/low|--low|force-low)(?=\\s|$)"],
      "tier": "low",
      "reason": "Manual override flag forcing standard implementation tier."
    },
    {
      "matches": ["(?:^|\\s)(!micro|/micro|--micro|force-micro)(?=\\s|$)"],
      "tier": "micro",
      "reason": "Manual override flag forcing lightweight environment tier."
    },
    {
      "matches": [
        "\\brace conditions?\\b",
        "\\bdeadlocks?\\b",
        "\\bmemory leaks?\\b",
        "\\bmutex(es)?\\b",
        "\\bsemaphores?\\b",
        "\\bcrash dumps?\\b",
        "\\bpropose_goal_draft\\b",
        "\\bupdate_goal\\b",
        "\\bapply_goal_tweak\\b",
        "\\b(audit_goal|goal_audit|goal auditing|audit goal)\\b",
        "\\brearchitect\\b",
        "\\bcompletely revise\\b"
      ],
      "tier": "high",
      "reason": "High-priority concurrency bugs, rearchitectures, and goal mutations evaluated before general verbs."
    },
    {
      "matches": [
        "\\barchitect(ure|ing)?\\b",
        "\\brefactor(ing|ed)?\\b",
        "\\b(db|database|atomic) transactions?\\b"
      ],
      "tier": "medium",
      "reason": "Mid-tier structural refactoring and transactional logic."
    },
    {
      "matches": [
        "\\bprofil(e|ing)\\b",
        "\\bbenchmarks?\\b",
        "\\bslowdowns?\\b",
        "\\bstuck\\b",
        "\\bhanging\\b",
        "\\bfreez(e|ing)\\b",
        "\\boptimiz(e|ation)\\b",
        "\\bperformance\\b",
        "\\b(get_goal|pause_goal|abort_goal)\\b"
      ],
      "tier": "low",
      "reason": "Standard performance profiling metrics and read-only goal checks."
    }
  ],
  "fallbacks": {
    "inference_coop/regolo/apertus-70b": [
      "ollama/ornith-pi:latest",
      "ollama/inkling-pi:latest",
      "ollama/granite-30b-pi:latest",
      "ollama/north-mini-pi:latest"
    ],
    "ollama/inkling-pi:latest": [
      "ollama/ornith-pi:latest",
      "ollama/granite-30b-pi:latest",
      "ollama/north-mini-pi:latest"
    ],
    "ollama/ornith-pi:latest": [
      "ollama/granite-30b-pi:latest",
      "ollama/north-mini-pi:latest"
    ],
    "ollama/granite-30b-pi:latest": ["ollama/north-mini-pi:latest"],
    "ollama/north-mini-pi:latest": [
      "ollama/granite-8b-pi:latest",
      "ollama/flint-pi:latest"
    ],
    "ollama/granite-8b-pi:latest": ["ollama/flint-pi:latest"],
    "ollama/flint-pi:latest": []
  }
}
