{
  "debug": true,
  "defaultContextThresholdPercent": 80,
  "contextThresholdPercentOverrides": {
    "ollama/granite-8b-pi:latest": 75,
    "ollama/lfm-pi:latest": 85,
    "ollama/granite-30b-pi:latest": 80
  },
  "maxContextTokens": 131072,
  "onContextOverflow": "truncate",
  "classifierModel": "ollama/pi-classifier:latest",
  "classifierModels": ["ollama/pi-classifier:latest"],
  "classifier": {
    "enabled": true,
    "models": ["ollama/pi-classifier:latest"]
  },
  "stickyTierDurationTurns": 4,
  "stickyTierCooldownTurns": 1,
  "minTurnsPerTier": 1,
  "phaseMemory": true,
  "phaseMemoryConfig": {
    "decayRate": 0.1,
    "boostRulesTier": false
  },
  "profiles": {
    "auto": {
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "temperature": 0.0,
          "num_ctx": 65536,
          "num_predict": 4096,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": -1,
          "timeout": "60s"
        }
      },
      "medium": {
        "model": "ollama/lfm-pi:latest",
        "contextWindow": 131072,
        "thinking": "off",
        "options": {
          "temperature": 0.1,
          "num_ctx": 131072,
          "num_predict": 8192,
          "num_thread": 8,
          "keep_alive": -1,
          "timeout": "90s"
        }
      },
      "high": {
        "model": "ollama/granite-30b-pi:latest",
        "contextWindow": 131072,
        "thinking": "high",
        "options": {
          "temperature": 0.1,
          "num_ctx": 131072,
          "num_predict": 8192,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": "1m",
          "system": "You are executing an autonomous goal loop. Use your deep internal reasoning to orchestrate complex architectural strategies.",
          "timeout": "300s"
        }
      }
    }
  },
  "rules": [
    {
      "matches": ["!high", "/high", "--high", "architect", "force-high"],
      "tier": "high",
      "reason": "Explicit manual overrides to force the heavy reasoning model"
    },
    {
      "matches": ["!medium", "/medium", "--medium", "force-medium"],
      "tier": "medium",
      "reason": "Manual override flag forcing standard implementation tier"
    },
    {
      "matches": ["!low", "/low", "--low", "force-low"],
      "tier": "low",
      "reason": "Manual override flag forcing lightweight low tier"
    },
    {
      "matches": [
        "race condition",
        "deadlock",
        "memory leak",
        "gil ",
        "mutex",
        "semaphore",
        "crash dump"
      ],
      "tier": "high",
      "reason": "Strict runtime concurrency bugs and engine-level diagnostics that warrant single-turn 30B analysis"
    },
    {
      "matches": [
        "create_goal",
        "get_goal",
        "update_goal",
        "propose_goal_draft",
        "set_goal_tasks",
        "goal_questionnaire",
        "goal_confirmation",
        "goal_topic",
        "[goal]",
        "__goal__",
        "<goal_topic>",
        "/goal",
        "update_goal_task",
        "goal loop",
        "orchestration loop"
      ],
      "tier": "medium",
      "reason": "Pi-Goal orchestrations and planning workloads intercepted by the medium tier to bypass high stickiness"
    },
    {
      "matches": [
        "write",
        "implement",
        "create",
        "generate",
        "patch",
        "refactor",
        "modify",
        "update",
        "migrate",
        "port",
        "translate",
        "integrate",
        "api compatibility",
        "function ",
        "import "
      ],
      "tier": "medium",
      "reason": "Standard coding actions, migrations, feature implementation, and Django ecosystem pipelines"
    },
    {
      "matches": [
        "continue",
        "next",
        "go ahead",
        "ok",
        "yes",
        "proceed",
        "run it",
        "execute"
      ],
      "tier": "medium",
      "reason": "Egress Escape: Conversational continuations explicitly drop the router back down to the medium tier"
    },
    {
      "matches": [
        "print",
        "echo",
        "format",
        "lint",
        "prettier",
        "eslint",
        "ruff",
        "black",
        "pip",
        "npm",
        "install",
        "bump",
        "version",
        "typo",
        "fix typo",
        "comment",
        "comments",
        "docs",
        "docstring",
        "rubocop",
        "flake8",
        "autopep8",
        "run tests",
        "pytest",
        "unittest",
        "readme",
        "changelog",
        "yaml",
        "toml",
        "json",
        "ini",
        "cfg",
        "conf",
        "setup.cfg"
      ],
      "tier": "low",
      "reason": "Environment hygiene, lint runs, syntax formatting, and lightweight configurations"
    },
    {
      "matches": ["test", "ping", "clear session", "reset context"],
      "tier": "low",
      "reason": "Deterministic system check patterns and workflow diagnostics"
    },
    {
      "matches": [
        "system design",
        "infrastructure",
        "db replica",
        "sharding",
        "deep dive",
        "benchmark",
        "profile",
        "hang",
        "stuck",
        "slowdown",
        "freeze"
      ],
      "tier": "high",
      "reason": "Fallback high-level structural planning and performance investigation keywords"
    }
  ],
  "fallbacks": {
    "ollama/granite-30b-pi:latest": ["ollama/lfm-pi:latest"],
    "ollama/lfm-pi:latest": ["ollama/granite-8b-pi:latest"]
  }
}
