{
  "debug": true,
  "defaultContextThresholdPercent": 80,
  "contextThresholdPercentOverrides": {
    "ollama/granite-8b-pi:latest": 75,
    "ollama/mistral-pi:latest": 90,
    "ollama/granite-30b-pi:latest": 80
  },
  "maxContextTokens": 131072,
  "onContextOverflow": "truncate",
  "classifierModel": "ollama/pi-classifier:latest",
  "classifierModels": ["ollama/pi-classifier:latest"],
  "classifier": {
    "enabled": true,
    "models": ["ollama/pi-classifier:latest"]
  },
  "stickyTierDurationTurns": 1,
  "minTurnsPerTier": 1,
  "phaseMemory": false,
  "defaultProfile": "granite",
  "profiles": {
    "auto": {
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "temperature": 0.0,
          "num_ctx": 65536,
          "num_predict": 4096,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": -1,
          "timeout": "60s",
          "stop": ["</tool_call>", "</function>", "</parameter>"]
        }
      },
      "medium": {
        "model": "ollama/devstral-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "temperature": 0.0,
          "num_ctx": 65536,
          "num_predict": 4096,
          "num_thread": 8,
          "keep_alive": -1,
          "timeout": "90s"
        }
      },
      "high": {
        "model": "ollama/granite-30b-pi:latest",
        "contextWindow": 131072,
        "thinking": "high",
        "options": {
          "temperature": 0.1,
          "num_ctx": 131072,
          "num_predict": 8192,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": "1m",
          "system": "You are executing an autonomous goal loop. Use your deep internal reasoning to orchestrate complex architectural strategies.",
          "stop": ["</tool_call>", "</function>", "</parameter>"],
          "timeout": "300s"
        }
      }
    },
    "granite": {
      "low": {
        "model": "ollama/granite-8b-pi:latest",
        "contextWindow": 65536,
        "thinking": "off",
        "options": {
          "think": false,
          "temperature": 0.0,
          "num_ctx": 65536,
          "num_predict": 4096,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": -1,
          "timeout": "45s",
          "stop": ["</tool_call>", "</function>", "</parameter>"]
        }
      },
      "medium": {
        "model": "ollama/granite-8b-pi:latest",
        "contextWindow": 65536,
        "thinking": "high",
        "options": {
          "think": "high",
          "temperature": 0.2,
          "num_ctx": 65536,
          "num_predict": 8192,
          "num_thread": 8,
          "keep_alive": -1,
          "timeout": "120s"
        }
      },
      "high": {
        "model": "ollama/granite-30b-pi:latest",
        "contextWindow": 131072,
        "thinking": "high",
        "options": {
          "think": "high",
          "temperature": 0.3,
          "num_ctx": 131072,
          "num_predict": 8192,
          "num_thread": 8,
          "f16_kv": false,
          "keep_alive": -1,
          "system": "You are executing an autonomous goal loop inside the Pi framework. Use your deep internal reasoning to orchestrate complex architectural strategies.",
          "stop": ["</tool_call>", "</function>", "</parameter>"],
          "timeout": "300s"
        }
      }
    }
  },
  "rules": [
    {
      "matches": ["!high", "/high", "--high", "architect", "force-high"],
      "tier": "high",
      "reason": "Explicit manual overrides to force the heavy reasoning model"
    },
    {
      "matches": ["!medium", "/medium", "--medium", "force-medium"],
      "tier": "medium",
      "reason": "Manual override flag forcing standard implementation tier"
    },
    {
      "matches": ["!low", "/low", "--low", "force-low"],
      "tier": "low",
      "reason": "Manual override flag forcing lightweight low tier"
    },
    {
      "matches": [
        "race condition",
        "deadlock",
        "memory leak",
        "mutex",
        "semaphore",
        "transaction",
        "crash dump"
      ],
      "tier": "high",
      "reason": "Strict runtime concurrency bugs and engine-level diagnostics that warrant single-turn 30B analysis"
    },
    {
      "matches": [
        "propose_goal_draft",
        "goal_question",
        "goal_questionnaire",
        "update_goal",
        "get_goal",
        "apply_goal_tweak",
        "abort_goal",
        "pause_goal"
      ],
      "tier": "high",
      "reason": "Intercepts native goal tool calls and locks the session into the Granite-30B reasoning tier"
    },
    {
      "matches": [
        "write",
        "implement",
        "create",
        "generate",
        "patch",
        "refactor",
        "modify",
        "update",
        "migrate",
        "port",
        "translate",
        "integrate",
        "endpoint",
        "route",
        "class ",
        "def ",
        "function ",
        "import "
      ],
      "tier": "medium",
      "reason": "Pure implementation, feature writing, and codebase modification verbs intercepted by the medium tier"
    },
    {
      "matches": [
        "profile",
        "benchmark",
        "slowdown",
        "stuck",
        "hang",
        "freeze",
        "optimize",
        "performance"
      ],
      "tier": "medium",
      "reason": "Standard performance profiling, code optimization, and loop diagnostics handled in the medium tier"
    },
    {
      "matches": [
        "continue",
        "next",
        "go ahead",
        "ok",
        "yes",
        "proceed",
        "run it",
        "execute"
      ],
      "tier": "medium",
      "reason": "Egress Escape: Conversational continuations explicitly drop the router back down to the medium tier"
    },
    {
      "matches": [
        "print",
        "echo",
        "format",
        "lint",
        "prettier",
        "eslint",
        "ruff",
        "black",
        "pip",
        "npm",
        "install",
        "bump",
        "version",
        "typo",
        "fix typo",
        "comment",
        "comments",
        "docs",
        "docstring",
        "rubocop",
        "flake8",
        "autopep8",
        "run tests",
        "pytest",
        "unittest",
        "readme",
        "changelog",
        "yaml",
        "toml",
        "json",
        "ini",
        "cfg",
        "conf",
        "setup.cfg",
        "manage.py",
        "run make",
        "rake"
      ],
      "tier": "low",
      "reason": "Environment hygiene, lint runs, syntax formatting, and lightweight configurations safely handled by Granite-8B tools"
    },
    {
      "matches": ["test", "ping", "clear session", "reset context"],
      "tier": "low",
      "reason": "Deterministic system check patterns and workflow diagnostics"
    }
  ],
  "fallbacks": {
    "ollama/granite-30b-pi:latest": ["ollama/mistral-pi:latest"],
    "ollama/mistral-pi:latest": ["ollama/granite-8b-pi:latest"]
  }
}
