{
  "project": {
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/venv/**",
      "**/.turbo/**",
      "**/.cache/**",
      "**/logs/**"
    ],
    "max_file_read_size_kb": 256
  },
  "worktrees": {
    "enabled": true,
    "baseDir": "~/worktrees",
    "isolate_scratchpad": true
  }
}
