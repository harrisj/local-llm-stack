{
  "project": {
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/venv/**",
      "**/.turbo/**",
      "**/.cache/**",
      "**/logs/**"
    ],
    "max_file_read_size_kb": 256
  },
  "worktrees": {
    "enabled": true,
    "baseDir": "~/worktrees",
    "isolate_scratchpad": true
  },
  "pi-lens": {
    "lsp": true,
    "linters": true,
    "prettier": true,
    "tsc": true,
    "excludePatterns": ["node_modules/**", ".git/**", "dist/**", "build/**"],
    "lspDelayMs": 1000,
    "maxConcurrency": 1
  }
}
