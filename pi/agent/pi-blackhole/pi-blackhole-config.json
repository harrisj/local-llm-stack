{
  "enabled": true,
  "strategy": "compaction",
  "triggerThresholdPercent": 70,
  "targetReductionPercent": 20,
  "preserveRecentTurns": 4,
  "clearCacheOnModelSwitch": true,
  "tokenWeighting": {
    "systemPrompt": 1,
    "userPrompt": 1,
    "codeBlocks": 0.85
  },
  "languageSpecifics": {
    "python": {
      "stripDocstringsOnCritical": true,
      "preserveImports": true
    },
    "ruby": {
      "stripCommentsOnCritical": true
    }
  },
  "debug": false,
  "sessionFallback": false,
  "compaction": "auto",
  "compactionEngine": "blackhole",
  "compactionSummaryMode": "default",
  "skipForProviders": [],
  "tailBehavior": "minimal",
  "contextPressureFallback": "off",
  "showPreCompactionMessage": true,
  "retainedToolOutputMaxTokens": 16000,
  "recallResponseMaxChars": 40000,
  "midRunCompaction": "off",
  "observeAfterTokens": 20000,
  "reflectAfterTokens": 35000,
  "compactAfterPreset": "default",
  "observationsPoolMaxTokens": 16000,
  "reflectionsPoolMaxTokens": 8000,
  "observeOnShutdown": false,
  "fullFoldAlways": true,
  "reflectionTimestamps": true,
  "reflectionSupersedes": false,
  "observationsPoolTargetTokens": 8000,
  "reflectorInputMaxTokens": 45000,
  "dropperInputMaxTokens": 45000,
  "dropperPressureThreshold": 0.6,
  "dropperPoolFullnessThreshold": 0.1,
  "observerChunkMaxTokens": 32000,
  "observerPreambleMaxTokens": 0,
  "agentMaxTurns": 16,
  "memory": true,
  "debugLog": false,
  "statusBar": false,
  "showWorkerNotifications": true
}
