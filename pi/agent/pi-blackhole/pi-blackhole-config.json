{
  "enabled": true,
  "strategy": "compaction",
  "triggerThresholdPercent": 80,
  "targetReductionPercent": 20,
  "preserveRecentTurns": 4,
  "clearCacheOnModelSwitch": true,
  "tokenWeighting": {
    "systemPrompt": 1,
    "userPrompt": 1,
    "codeBlocks": 0.85
  },
  "languageSpecifics": {
    "python": {
      "stripDocstringsOnCritical": true,
      "preserveImports": true
    },
    "ruby": {
      "stripCommentsOnCritical": true
    }
  },
  "debug": false,
  "sessionFallback": false,
  "compaction": "auto",
  "compactionEngine": "blackhole",
  "compactionSummaryMode": "default",
  "skipForProviders": [],
  "tailBehavior": "minimal",
  "contextPressureFallback": "off",
  "showPreCompactionMessage": true,
  "retainedToolOutputMaxTokens": 4000,
  "recallResponseMaxChars": 40000,
  "midRunCompaction": "off",
  "observeAfterTokens": 16000,
  "reflectAfterTokens": 50000,
  "compactAfterPreset": "default",
  "observationsPoolMaxTokens": 8000,
  "reflectionsPoolMaxTokens": 4000,
  "observeOnShutdown": false,
  "fullFoldAlways": true,
  "reflectionTimestamps": true,
  "reflectionSupersedes": false,
  "observationsPoolTargetTokens": 4000,
  "reflectorInputMaxTokens": 16000,
  "dropperInputMaxTokens": 16000,
  "dropperPressureThreshold": 0.6,
  "dropperPoolFullnessThreshold": 0.1,
  "observerChunkMaxTokens": 16000,
  "observerPreambleMaxTokens": 0,
  "agentMaxTurns": 16,
  "memory": true,
  "debugLog": false,
  "statusBar": false,
  "showWorkerNotifications": true,
  "workers": {
    "observer": {
      "model": "ollama/granite-8b-pi:latest",
      "options": {
        "think": true,
        "num_ctx": 16000,
        "num_predict": 1024,
        "keep_alive": -1
      }
    },
    "reflector": {
      "model": "ollama/granite-8b-pi:latest",
      "options": {
        "think": true,
        "num_ctx": 16000,
        "num_predict": 2048,
        "keep_alive": -1
      }
    },
    "dropper": {
      "model": "ollama/granite-8b-pi:latest",
      "options": {
        "think": false,
        "num_ctx": 8000,
        "num_predict": 512,
        "keep_alive": -1
      }
    }
  }
}
