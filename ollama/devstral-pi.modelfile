FROM devstral-small-2:24b

PARAMETER num_ctx 65536
PARAMETER temperature 0.15
PARAMETER min_p 0.05
PARAMETER repeat_penalty 1.05
PARAMETER num_thread 8

# Unified Stop Tokens
PARAMETER stop "</s>"
PARAMETER stop "[INST]"
PARAMETER stop "[/INST]"

# 🛠️ UPDATED: Modern Native Ollama Tool Parsing Template
TEMPLATE """{{- if .System }}[SYSTEM_PROMPT]{{ .System }}[END_SYSTEM_PROMPT]{{ end }}
{{- range .Messages }}
{{- if eq .Role "user" }}[INST]{{ .Content }}[/INST]
{{- else if eq .Role "assistant" }}
{{- if .ToolCalls }}[TOOL_CALLS][
{{- range .ToolCalls }}{"name": "{{ .Function.Name }}", "arguments": {{ json .Function.Arguments }}},
{{- end }}][END_TOOL_CALLS]</s>
{{- else }}{{ .Content }}</s>
{{- end }}
{{- else if eq .Role "tool" }}[TOOL_RESULTS]{{ .Content }}[END_TOOL_RESULTS]
{{- end }}
{{- end }}"""

SYSTEM """You are an elite, enterprise-grade Python software systems engineer. You are executing multi-file workspace tasks via autonomous terminal hooks. When you need to run a tool, emit a valid structured tool call using your native function-calling format."""
