      "/Users/harrisj/.pi-lens",
      "/Users/harrisj/.agents",
      "/Users/harrisj/Library/Preferences",
      "/Users/harrisj/.gitconfig",
      "/Users/harrisj/.npmrc",
      "/Users/harrisj/package.json",
      "/Users/harrisj/Library/Application Support/rtk",
      "/Users/harrisj/.claude/settings.json"
